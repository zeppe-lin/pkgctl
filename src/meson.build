pkgctl_core = static_library(
  'pkgctl-core',
  [
    'check.cpp',
    'check_session_codec.cpp',
    'construction.cpp',
    'construction_session_codec.cpp',
    'dispatch.cpp',
    'controller.cpp',
    'core.cpp',
    'effect.cpp',
    'effect_inspect.cpp',
    'effect_journal.cpp',
    'effect_journal_codec.cpp',
    'effect_restart.cpp',
    'effect_store.cpp',
    'error.cpp',
    'identity.cpp',
    'native_policy.cpp',
    'operation_session_codec.cpp',
    'preparation.cpp',
    'progression.cpp',
    'report.cpp',
    'run_journal.cpp',
    'run_journal_codec.cpp',
    'run_inspect.cpp',
    'run_launch.cpp',
    'run_locator.cpp',
    'run_native.cpp',
    'run_nonce.cpp',
    'run_operation.cpp',
    'run_admit.cpp',
    'run_authority.cpp',
    'run_advance.cpp',
    'run_reconcile.cpp',
    'run_recovery.cpp',
    'run_progress.cpp',
    'run_resource.cpp',
    'run_commit.cpp',
    'run_cleanup.cpp',
    'run_drive.cpp',
    'run_evidence.cpp',
    'run_evidence_codec.cpp',
    'run_evidence_store.cpp',
    'run_execute.cpp',
    'run_restart.cpp',
    'run_runtime.cpp',
    'run_store.cpp',
    'request.cpp',
    'session.cpp',
    'target_observation.cpp',
  ],
  include_directories: pkgctl_inc,
  dependencies: pkgctl_core_authority_deps,
  install: false,
)

pkgctl_core_dep = declare_dependency(
  link_with: pkgctl_core,
  include_directories: pkgctl_inc,
  dependencies: pkgctl_core_authority_deps,
)
