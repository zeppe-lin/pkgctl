option(
  'link_mode',
  type: 'combo',
  choices: ['shared', 'static'],
  value: 'shared',
  description: 'link pkgctl against shared or static authority libraries',
)

option(
  'tests',
  type: 'feature',
  value: 'auto',
  description: 'build the pkgctl regression suite',
)

option(
  'man_pages',
  type: 'feature',
  value: 'auto',
  description: 'build scdoc manual pages',
)
